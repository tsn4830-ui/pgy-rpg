rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能讀寫自己的存檔
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 匿名遊玩人數：每天一筆，只能把 visitors／start／finish 各加 1，任何人都不能讀或刪
    match /stats/{day} {
      function plusOne(f) {
        return !(f in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
          || request.resource.data[f] == (resource == null ? 0 : resource.data.get(f, 0)) + 1;
      }
      allow create, update: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visitors', 'start', 'finish'])
        && plusOne('visitors') && plusOne('start') && plusOne('finish');
      allow read, delete: if false;
    }
  }
}
